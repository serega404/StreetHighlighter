# HTTP port published by Docker Compose.
STREETHIGHLIGHTER_PORT=8080

# Set a long random value before exposing the API publicly.
API_KEY=

# Swagger is disabled in the production container unless explicitly enabled.
EnableSwagger=false

# Identify your application with a contact address when using public OSM services.
ExternalServices__UserAgent=StreetHighlighter/1.0 (contact@example.com)

# Override these only when using compatible self-hosted or paid providers.
ExternalServices__Nominatim__Url=https://nominatim.openstreetmap.org/search
ExternalServices__Nominatim__TimeoutSeconds=10
ExternalServices__Nominatim__MaxRetries=2
ExternalServices__Nominatim__RetryDelayMilliseconds=500
ExternalServices__Nominatim__MaxResponseBytes=2097152

ExternalServices__Overpass__Url=https://overpass-api.de/api/interpreter
ExternalServices__Overpass__TimeoutSeconds=30
ExternalServices__Overpass__MaxRetries=2
ExternalServices__Overpass__RetryDelayMilliseconds=1000
ExternalServices__Overpass__MaxResponseBytes=67108864

ExternalServices__Tiles__Url=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ExternalServices__Tiles__TimeoutSeconds=10
ExternalServices__Tiles__MaxRetries=2
ExternalServices__Tiles__RetryDelayMilliseconds=250
ExternalServices__Tiles__MaxResponseBytes=5242880
